{
    "include": [
        "./**/*.js",
        "./**/*.ts",
        "../types/**/*.d.ts",
        "../../.probe/@package/**/*.d.ts",
        "../../.probe/@side-only/client/**/*.d.ts",
        "../../.probe/@special/**/*.d.ts"
    ],
    "compilerOptions": {
        "ignoreDeprecations": "6.0",
        "module": "commonjs",
        "moduleResolution": "node",
        "allowJs": true,
        "checkJs": false,
        "target": "ES2022",
        "disableSizeLimit": true,
        "noEmit": true,
        "assumeChangesOnlyAffectDirectDependencies": true,
        "skipLibCheck": true,
        "skipDefaultLibCheck": true,
        "lib": [
            "ES2022"
        ],
        "paths": {
            "@package": [
                "../../.probe/@package"
            ],
            "@package/*": [
                "../../.probe/@package/*"
            ],
            "@side-only/client": [
                "../../.probe/@side-only/client"
            ],
            "@side-only/client/*": [
                "../../.probe/@side-only/client/*"
            ],
            "@special": [
                "../../.probe/@special"
            ],
            "@special/*": [
                "../../.probe/@special/*"
            ]
        }
    },
    "typeAcquisition": {
        "enable": false
    }
}
