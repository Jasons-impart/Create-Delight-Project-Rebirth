# Repository allowlist. Runtime files are ignored by default.
/*

# Repo metadata
!/.gitattributes
!/.gitignore
!/.prettierrc
!/.prettierignore
!/.github/
!/.github/**
!/.agents/
!/.agents/**
!/.husky/
!/.husky/**
!/.vscode/
/.vscode/*
!/.vscode/extensions.json

# Pack metadata and generated release-root files
!/package.json
!/package-lock.json
!/.pw/
/.pw/*
!/.pw/config.toml
!/.packwizignore
!/pack/
!/pack/**

# Docs and project assets
!/README.md
!/AGENTS.md
!/LICENSE
!/docs/
!/docs/**

# Launchers and local examples
!/devtool.bat
!/devtool.sh

# Packwiz-managed downloads. Track descriptors, never downloaded jars/zips.
!/mods/
!/mods/*.pw.toml
!/resourcepacks/
!/resourcepacks/**
!/shaderpacks/
!/shaderpacks/**

# Maintained pack data
!/config/
!/defaultconfigs/
!/defaultconfigs/**
!/kubejs/
!/kubejs/**
!/ldlib/
!/ldlib/**
!/hotai/
!/hotai/**
!/schematics/
!/schematics/**
!/tacz/
!/tacz/**
!/minemenu/
!/minemenu/**
!/roots/
!/roots/**
!/scripts/
!/scripts/**

# Explicit runtime exclusions inside allowed directories.
docs/generated/
docs/generated/
scripts/bin/*
mods/*.jar
mods/*.jar.disabled
resourcepacks/*.zip
shaderpacks/*.zip
logs/
crash-reports/
saves/
/world/
/world*/
libraries/
versions/
downloads/
node_modules/
server.properties
eula.txt
user_jvm_args.txt
run.bat
run.sh
neoforge.jar
minecraft_server*.jar
*.log
*.lock
*.tmp

# Local dedicated test server runtime files.
test_server/

# Legacy local test server directory; keep ignored during migration.
server/

.probe
kubejs/config/probe-settings.json
kubejs/config/web_server.json
